<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/background_light">

        <EditText
            android:id="@+id/etDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Destination"
            android:padding="12dp"
            android:background="@drawable/shape_edittext"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select start date"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:background="@drawable/shape_edittext"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select end date"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:background="@drawable/shape_edittext"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter notes"
            android:padding="12dp"
            android:background="@drawable/shape_edittext"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Mood"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spinnerMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Background Music"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>
        <Spinner
            android:id="@+id/spinnerBgm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a Photo"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/photo1"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:src="@drawable/photo1"
                android:scaleType="centerCrop"
                android:background="@drawable/photo_border"
                android:layout_marginEnd="4dp"/>

            <ImageView
                android:id="@+id/photo2"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:src="@drawable/photo2"
                android:scaleType="centerCrop"
                android:background="@drawable/photo_border"
                android:layout_marginEnd="4dp"/>

            <ImageView
                android:id="@+id/photo3"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:src="@drawable/photo3"
                android:scaleType="centerCrop"
                android:background="@drawable/photo_border"
                android:layout_marginEnd="4dp"/>

            <ImageView
                android:id="@+id/photo4"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:src="@drawable/photo4"
                android:scaleType="centerCrop"
                android:background="@drawable/photo_border"
                android:layout_marginEnd="4dp"/>

            <ImageView
                android:id="@+id/photo5"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:src="@drawable/photo5"
                android:scaleType="centerCrop"
                android:background="@drawable/photo_border"/>
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a Memory Song"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnAudio1"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnAudio2"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="2"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnAudio3"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="3"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnAudio4"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnAudio5"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="5"
                android:layout_weight="1"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Memory"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>